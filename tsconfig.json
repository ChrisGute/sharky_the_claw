{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "vite.config.js",
    "vitest.config.js",
    "playwright.config.js"
  ]
}
