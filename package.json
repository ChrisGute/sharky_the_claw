{
  "name": "sharky-the-claw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static browser game built with Phaser.",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate:content": "node ./scripts/validate-content.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node ./scripts/run-e2e.js",
    "audit:lighthouse": "npm run build && node ./scripts/audit-lighthouse.js",
    "verify:deployment": "node ./scripts/verify-deployment.js",
    "build": "vite build",
    "check:production": "node ./scripts/check-production.js",
    "preview": "vite preview"
  },
  "license": "MIT",
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "lighthouse": "^12.8.2",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.8"
  }
}
